{
  "name": "studioflow",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "echo \"\\n\\n🟢 ADMIN MAGIC LINK: http://localhost:3000/?token=studioflow-admin-key\\n⚪ NORMAL PUBLIC LINK: http://localhost:3000/\\n\\n\" && turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "predaemon": "brew services start redis",
    "daemon": "pnpm --filter studioflow-cli exec node -r dotenv/config index.js watch",
    "db:reset": "node -r dotenv/config wipe.js && pnpm --filter @studioflow/db db:push"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.22.5"
  }
}
