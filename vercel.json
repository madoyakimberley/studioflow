{
  "version": 2,
  "name": "studioflow-dashboard",
  "framework": "nextjs",
  "buildCommand": "pnpm build --filter client-dashboard",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/client-dashboard/.next",
  "regions": ["pdx1"],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
